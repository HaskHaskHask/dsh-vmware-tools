{
  "name": "dsh-vmware-tools",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Model tools that read and control local VMware virtual machines through vmrun, with per-VM guest credentials.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md", "locale/*.json", "docs", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}
